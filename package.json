{
  "name": "@getclog/clog",
  "version": "0.1.0",
  "description": "Discover, curate, and share AI coding agent conversations as a searchable knowledge base",
  "keywords": [
    "ai",
    "coding-agent",
    "conversations",
    "knowledge-base",
    "search",
    "mcp",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BFriedland/clog.git"
  },
  "bugs": {
    "url": "https://github.com/BFriedland/clog/issues"
  },
  "author": "Ben Friedland",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "clog": "dist/index.js",
    "clog-mcp": "dist/mcp/server.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && node scripts/fix-bin-permissions.mjs",
    "prepare": "npm run build",
    "setup": "npm link && node dist/index.js init",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx src/index.ts",
    "lint": "eslint src/ tests/",
    "knip": "knip --treat-config-hints-as-errors",
    "smoke:global-runtime": "node scripts/smoke-global-runtime.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.3",
    "fflate": "^0.8.3",
    "glob": "^13.0.6",
    "proper-lockfile": "^4.1.2",
    "sql.js": "^1.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@types/node": "^22.13.4",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "knip": "^6.27.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.62.0",
    "vectra": "^0.15.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "clog.png"
  ]
}
